<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>KoreForge.Scripts.Core</PackageId>
    <AssemblyName>KoreForge.Scripts.Core</AssemblyName>
    <RootNamespace>KoreForge.Scripts.Core</RootNamespace>
    <Description>Core services for KoreForge script registry.</Description>
    <PackageTags>scripts;registry;services;core</PackageTags>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KoreForge.Scripts.Abstractions" VersionOverride="0.0.11-alpha.0" />
    <PackageReference Include="KoreForge.Scripts.Data" VersionOverride="0.0.11-alpha.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KoreForge.Time" VersionOverride="0.0.11-alpha.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KoreForge.Scripts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>