<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>KoreForge.Scripts.Abstractions</PackageId>
    <AssemblyName>KoreForge.Scripts.Abstractions</AssemblyName>
    <RootNamespace>KoreForge.Scripts</RootNamespace>
    <Description>Abstractions for KoreForge versioned script registry.</Description>
    <PackageTags>scripts;registry;versioned;multi-app</PackageTags>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KoreForge.Scripts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>