<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>KoreForge.Scripts.Data</PackageId>
    <AssemblyName>KoreForge.Scripts.Data</AssemblyName>
    <RootNamespace>KoreForge.Scripts.Data</RootNamespace>
    <Description>EF Core data layer for KoreForge script registry.</Description>
    <PackageTags>scripts;registry;efcore;data</PackageTags>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KoreForge.Scripts.Abstractions" VersionOverride="1.0.2-alpha" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KoreForge.Scripts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>