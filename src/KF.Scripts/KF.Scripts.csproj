<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Multi-DLL Bundling Pattern: TargetsForTfmSpecificBuildOutput

    This package bundles KF.Scripts.Abstractions, KF.Scripts.Core, KF.Scripts.Data,
    and KF.Scripts.AspNet into a single NuGet package (KoreForge.Scripts).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>KoreForge.Scripts</PackageId>
    <AssemblyName>KF.Scripts</AssemblyName>
    <RootNamespace>KF.Scripts</RootNamespace>
    <Description>KoreForge versioned script registry — SQL Server-backed script store with history, rollback, validation, change monitoring, and ASP.NET endpoints.</Description>
    <PackageTags>scripts;registry;versioned;multi-app;sql-server;rollback</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_IncludeScriptsAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="_IncludeScriptsAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_ScriptsAssemblies Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and (
          '%(ReferenceCopyLocalPaths.FileName)' == 'KF.Scripts.Abstractions' or
          '%(ReferenceCopyLocalPaths.FileName)' == 'KF.Scripts.Core' or
          '%(ReferenceCopyLocalPaths.FileName)' == 'KF.Scripts.Data' or
          '%(ReferenceCopyLocalPaths.FileName)' == 'KF.Scripts.AspNet')" />
      <TfmSpecificPackageFile Include="@(_ScriptsAssemblies)">
        <PackagePath>lib\$(TargetFramework)\</PackagePath>
        <BuildOutputInPackage>true</BuildOutputInPackage>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\KF.Scripts.Abstractions\KF.Scripts.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\KF.Scripts.Core\KF.Scripts.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\KF.Scripts.Data\KF.Scripts.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\KF.Scripts.AspNet\KF.Scripts.AspNet.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KF.Scripts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
