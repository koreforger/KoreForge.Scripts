      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KF.Scripts.Abstractions\KF.Scripts.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\KF.Scripts.Core\KF.Scripts.Core.csproj" />
    <ProjectReference Include="..\..\src\KF.Scripts.Data\KF.Scripts.Data.csproj" />
    <ProjectReference Include="..\..\src\KF.Scripts.AspNet\KF.Scripts.AspNet.csproj" />
    <ProjectReference Include="..\..\src\KF.Scripts\KF.Scripts.csproj" />
    <ProjectReference Include="..\..\src\KF.Scripts.Cli\KF.Scripts.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
